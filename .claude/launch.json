{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "customer",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:customer"
      ],
      "port": 5173
    },
    {
      "name": "manager",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:manager"
      ],
      "port": 5174
    },
    {
      "name": "customer-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:customer:mock"
      ],
      "port": 5175
    },
    {
      "name": "customer-mock-auth",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_MOCK=1",
        "VITE_SUPABASE_URL=http://127.0.0.1:9",
        "VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_mock",
        "npm",
        "run",
        "dev",
        "-w",
        "apps/customer",
        "--",
        "--port",
        "5179"
      ],
      "port": 5179
    },
    {
      "name": "manager-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:manager:mock"
      ],
      "port": 5176
    },
    {
      "name": "customer-mock-win",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_API_MOCK=1&& npm run dev -w apps/customer -- --port 5178"
      ],
      "port": 5178
    },
    {
      "name": "customer-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "apps/customer",
        "--",
        "--port",
        "5177"
      ],
      "port": 5177
    }
  ]
}
