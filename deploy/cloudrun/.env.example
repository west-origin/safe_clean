# 복사하여 이 폴더의 .env로 작성한다. git에 넣지 않는다.
# Java properties 형식: 값에 따옴표·인라인 주석을 붙이지 않는다.
# 역슬래시는 \\로 이스케이프한다. Firebase JSON은 base64 한 줄.
# 이 파일 전체를 Secret Manager에 저장하고 Cloud Run에 파일로 마운트한다.
DB_URL=jdbc:postgresql://<dashboard-session-pooler-host>:5432/postgres?sslmode=require
DB_USER=postgres.qztjikulkicryvmgfuaw
DB_PASSWORD=
SUPABASE_URL=https://qztjikulkicryvmgfuaw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_MODE=jwks
SUPABASE_STORAGE_S3_ENDPOINT=https://qztjikulkicryvmgfuaw.supabase.co/storage/v1/s3
SUPABASE_STORAGE_S3_ACCESS_KEY=
SUPABASE_STORAGE_S3_SECRET_KEY=
SUPABASE_STORAGE_S3_REGION=ap-northeast-2
ALLOWED_ORIGINS=capacitor://localhost,https://localhost,ionic://localhost
SMS_PROVIDER=solapi
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=
OTP_SALT=
PUSH_MODE=fcm
FIREBASE_SERVICE_ACCOUNT_JSON=
LIVEKIT_MODE=cloud
LIVE_SOURCE=app
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ADMIN_TOKEN=
# 토스페이먼츠 API 개별 연동 키. 미설정이면 결제 비활성. 실제 값은 Secret Manager 파일에만 저장.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 카카오 로컬 API REST 키 (주소 검색). 비우면 주소 검색 결과가 빈 목록(직접 입력만)
KAKAO_REST_API_KEY=
