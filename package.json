{
  "name": "ansimclean",
  "private": true,
  "version": "0.1.0",
  "description": "안심클린 고객용/매니저용 앱 (React + Vite + Capacitor)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:customer": "npm run dev -w apps/customer",
    "dev:manager": "npm run dev -w apps/manager",
    "dev:customer:mock": "VITE_API_MOCK=1 npm run dev -w apps/customer -- --port 5175",
    "dev:manager:mock": "VITE_API_MOCK=1 npm run dev -w apps/manager -- --port 5176",
    "build": "npm run build --workspaces --if-present",
    "tokens": "node scripts/build-tokens.js",
    "check:tokens": "node scripts/check-tokens.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run cap:sync --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
