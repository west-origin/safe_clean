# 복사해서 backend/.env 로 쓴다. .env 는 커밋하지 않는다 (루트 .gitignore 가 막는다).
# 값의 출처와 설정 절차는 BACKEND_PLAN.md §12, docs/runbook.md(B1 에서 생성).
# 프로필은 .env 로 켜지지 않는다(.env 는 property source 라 SPRING_ 매핑이 안 됨) — 실행 인자로: ./mvnw spring-boot:run -Dspring-boot.run.profiles=local
# SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
# 운영(prod)에서는 앱 origin 만: ALLOWED_ORIGINS=capacitor://localhost,https://localhost,ionic://localhost  (http://localhost:* 는 개발 서버용 — 운영 .env 에 넣지 않는다, 보안 검토 2026-09-22)
ALLOWED_ORIGINS=capacitor://localhost,https://localhost,ionic://localhost,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# Supabase Postgres — Session pooler(5432). Transaction pooler(6543)는 JPA 와 맞지 않는다
DB_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.<project-ref>
DB_PASSWORD=

# Supabase Auth · Storage (service_role 키는 서버에만. 앱·git 금지)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_MODE=jwks
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_STORAGE_S3_ACCESS_KEY=
SUPABASE_STORAGE_S3_SECRET_KEY=
SUPABASE_STORAGE_S3_REGION=ap-northeast-2

# LiveKit Cloud (Ingress · Egress 활성). LIVEKIT_MODE=cloud 로 바꿔야 실제로 부른다 (logging = 카메라가 붙지 않는 대역)
LIVEKIT_MODE=logging
# 영상 출처: app = 매니저 휴대폰 카메라 송출(기본) · ingress = 바디캠(RTMP Ingress). 비우면 app
LIVE_SOURCE=app
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 관리자 API (/admin/**, 바디캠 등록 §13-20). 비어 있으면 닫힌다. openssl rand -hex 32
ADMIN_TOKEN=
# 토스페이먼츠 API 개별 연동 키(같은 상점의 client/secret 쌍). 비우면 결제 비활성.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 프록시 뒤에 둘 때만 클라이언트 IP 헤더 이름 (Fly.io: Fly-Client-IP · 일반 프록시: X-Forwarded-For). 비우면 remoteAddr — 직접 노출된 서버에서 헤더를 믿으면 IP 속도 제한을 우회당한다
CLIENT_IP_HEADER=

# 인증번호 문자 (국내 문자 API. local 프로필은 logging = 콘솔 출력)
SMS_PROVIDER=logging   # 로컬은 logging(콘솔 출력). 운영은 반드시 solapi — 비우면 기동 실패(문자 없이 인증번호가 로그로만 나가지 않게)
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=01000000000
OTP_SALT=

# 푸시 (B6). 서비스 계정 JSON 을 base64 한 줄로
PUSH_MODE=logging      # 로컬은 logging(로그만). 운영은 반드시 fcm — 비우면 기동 실패
FIREBASE_SERVICE_ACCOUNT_JSON=   # fcm 일 때: 서비스 계정 JSON 을 base64 한 줄로 (base64 -i service-account.json | tr -d '\n')
